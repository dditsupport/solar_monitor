<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device-transfer rules. The saved-device list is
     kept; the cloud session store (base URL, username, device token and the
     login cookies) is not, so a restored phone signs in again instead of
     reusing a session copied from another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/cloud_session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/cloud_session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
